{
  "name": "texconv-js",
  "version": "0.0.1",
  "description": "GPU (WebGPU) texture converter — a TypeScript port of Microsoft DirectXTex texconv",
  "type": "module",
  "main": "dist/texconv-js.js",
  "module": "dist/texconv-js.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "deploy": "npm run build && wrangler deploy",
    "build:lib": "vite build --config vite.lib.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit",
    "test:gpu": "vitest run --project gpu",
    "test:all": "vitest run"
  },
  "keywords": [
    "texture",
    "dds",
    "bc7",
    "bc6h",
    "webgpu",
    "directxtex",
    "texconv",
    "block-compression"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@vitest/browser": "^3.2.6",
    "@webgpu/types": "^0.1.60",
    "playwright": "^1.60.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.6",
    "wrangler": "^4.99.0"
  }
}
